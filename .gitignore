# Docusaurus
/.docusaurus
/build

# Generated for-LLM full-text export (regenerated by the `prebuild` script)
/static/llms-full.txt

# Dependencies
/node_modules

# Yarn (Berry) — keep config, ignore cache/state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PUBLIC repo — never track secrets. (Added on the repo split: this folder used
# to sit inside strata-storage and inherit that repo's root .gitignore.)
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
key.properties
keystore.properties
*service-account*.json
.npmrc

# Custom patterns required in every project (global standard)
*.ignore.*
project-record-ignore/
